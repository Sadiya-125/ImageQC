# --- Python (backend/, ml_training/) ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# --- Environment variables ---
.env
.env.*
!.env.example

# --- ML model weights & training artifacts ---
*.pt
*.pth
*.onnx
*.ckpt
ml_training/checkpoints/
ml_training/runs/
# backend/app/ml/weights/ holds the actual deployed inference artifacts
# (trained CNN weights, fitted feature scaler, fitted Isolation Forest,
# model version metadata, calibration temperatures) -- small (~5.5MB total)
# and required for the app to run at all after a fresh clone or a Render
# deploy build, so these are deliberately committed despite the blanket
# *.pt rule above. train_checkpoint.pt (a full resumable-training snapshot
# -- model + optimizer state -- not needed for inference) stays ignored.
backend/app/ml/weights/*
!backend/app/ml/weights/mobilenetv3_iqa.pt
!backend/app/ml/weights/anomaly_iforest.joblib
!backend/app/ml/weights/feature_scaler.joblib
!backend/app/ml/weights/model_metadata.json
!backend/app/ml/weights/calibration.json

# --- KADID-10k dataset (downloaded, not committed — see
#     ml_training/data_gen/download_kadid10k.py). split.csv is deliberately
#     re-included below: it's a small, derived artifact (our reference-image
#     train/val/test split) worth versioning, unlike the ~3GB of raw images
#     and dmos.csv metadata it sits alongside. ---
ml_training/data_gen/kadid10k/*
!ml_training/data_gen/kadid10k/split.csv
ml_training/data_gen/*.tgz

# --- Node ---
# frontend/ already has its own .gitignore covering node_modules, .next,
# build output, etc. for that folder — not duplicated here.

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/
