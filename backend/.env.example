# Copy this to backend/.env and adjust as needed. No real secrets belong in
# this file (.env.example) -- it's checked into git. backend/.env itself is
# gitignored.
#
# Every value below is already the default in app/core/config.py, so a
# fresh backend/.env can start empty and only override what differs.

# Neon's pooled connection string in production; local docker-compose
# Postgres for local dev. SQLAlchemy async -> asyncpg driver.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/imageqc

# Neon's *direct* (non-pooled) connection string, used only by Alembic
# migrations (see backend/app/alembic/env.py) -- PgBouncer's pooled
# connections don't reliably support Alembic's DDL transactions. Same as
# DATABASE_URL for local dev, where there's no pooler in the loop at all.
DIRECT_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/imageqc

# Comma-separated list of allowed frontend origins (add the deployed Vercel
# URL here in production).
CORS_ORIGINS=http://localhost:3000

# Paths to the artifacts ml_training/train.py produces. The defaults
# already point at backend/app/ml/weights/ -- override only if you've
# placed them elsewhere.
MODEL_WEIGHTS_PATH=app/ml/weights/mobilenetv3_iqa.pt
ANOMALY_MODEL_PATH=app/ml/weights/anomaly_iforest.joblib
FEATURE_SCALER_PATH=app/ml/weights/feature_scaler.joblib

MAX_UPLOAD_MB=10
